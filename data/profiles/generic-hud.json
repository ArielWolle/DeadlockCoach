{
  "schema_version": 1,
  "id": "generic-hud",
  "name": "Any game · OCR starter",
  "adapter": "generic",
  "viewport": { "aspect_ratio": null, "max_width": 1600 },
  "nodes": [
    { "id": "clock_region", "op": { "type": "crop", "region": { "x": 0.47, "y": 0.01, "w": 0.06, "h": 0.034444444 } } },
    { "id": "clock_text", "inputs": ["clock_region"], "op": { "type": "ocr", "mode": "detect", "upscale": 3 } },
    { "id": "clock_number", "inputs": ["clock_text"], "op": { "type": "parse", "parser": "clock", "min": 0, "max": 86400 } },
    { "id": "clock_stable", "inputs": ["clock_number"], "op": { "type": "confirm", "frames": 2, "tolerance": 15, "max_age_ms": 30000 } }
  ],
  "outputs": { "match.clock_seconds": "clock_stable", "debug.clock_text": "clock_text" }
}
