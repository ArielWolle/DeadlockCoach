{
  "schema_version": 1,
  "id": "deadlock",
  "name": "Deadlock · calibrated adapter",
  "adapter": "deadlock",
  "viewport": { "aspect_ratio": 1.7777778, "max_width": 1600 },
  "nodes": [
    { "id": "game", "op": { "type": "custom", "name": "deadlock.scan" } },
    { "id": "clock", "inputs": ["game"], "op": { "type": "select", "path": "/game_clock_secs" } },
    { "id": "souls", "inputs": ["game"], "op": { "type": "select", "path": "/souls" } },
    { "id": "screen", "inputs": ["game"], "op": { "type": "select", "path": "/screen" } },
    { "id": "items", "inputs": ["game"], "op": { "type": "select", "path": "/items" } },
    { "id": "minimap", "inputs": ["game"], "op": { "type": "select", "path": "/minimap" } },
    { "id": "allies", "inputs": ["game"], "op": { "type": "select", "path": "/ally_heroes" } },
    { "id": "enemies", "inputs": ["game"], "op": { "type": "select", "path": "/enemy_heroes" } },
    { "id": "hp", "inputs": ["game"], "op": { "type": "select", "path": "/hp" } },
    { "id": "max_hp", "inputs": ["game"], "op": { "type": "select", "path": "/max_hp" } },
    { "id": "position", "inputs": ["game"], "op": { "type": "select", "path": "/minimap/you" } },
    { "id": "lane", "inputs": ["game"], "op": { "type": "select", "path": "/minimap/your_lane" } },
    { "id": "hero_status", "inputs": ["game"], "op": { "type": "select", "path": "/hero_status" } },
    { "id": "earned", "inputs": ["game"], "op": { "type": "select", "path": "/own_networth" } }
  ],
  "outputs": {
    "match.clock_seconds": "clock",
    "player.currency": "souls",
    "scene": "screen",
    "player.items": "items",
    "world.minimap": "minimap",
    "team.heroes": "allies",
    "opponents.heroes": "enemies",
    "player.hp": "hp",
    "player.max_hp": "max_hp",
    "player.map_position": "position",
    "player.lane_estimate": "lane",
    "world.hero_status": "hero_status",
    "player.earned_souls": "earned"
  }
}
